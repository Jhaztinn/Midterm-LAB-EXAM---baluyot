    /* INTEGER INPUT VALIDATIO*/

    public static int getIntegerInput(
            Scanner scanner,
            String message) {

        while (true) {

            System.out.print(message);

            if (scanner.hasNextInt()) {

                int number = scanner.nextInt();

                scanner.nextLine();

                return number;

            } else {

                System.out.println(
                        "Invalid input."
                                + " Please enter a number."
                );

                scanner.nextLine();
            }
        }
    }


    /* REGISTER PLAYE */

    public static void registerPlayer(
            Scanner scanner,
            QueueManager manager) {

        System.out.println();
        System.out.println("==================================");
        System.out.println("         REGISTER PLAYER");
        System.out.println("==================================");

        int id = getIntegerInput(
                scanner,
                "Enter Player ID: "
        );

        // Check duplicate ID
        if (manager.findPlayer(id) != null) {

            System.out.println();
            System.out.println(
                    "Player ID already exists."
            );

            return;
        }

        System.out.print("Enter Name: ");

        String name = scanner.nextLine();

        // Check empty name
        if (name.trim().isEmpty()) {

            System.out.println(
                    "Name cannot be empty."
            );

            return;
        }

        System.out.print(
                "Enter Skill Level "
                        + "(Beginner/Intermediate/Advanced): "
        );

        String skill = scanner.nextLine();

        // Check empty skill
        if (skill.trim().isEmpty()) {

            System.out.println(
                    "Skill level cannot be empty."
            );

            return;
        }

        System.out.println();
        System.out.println("Player Type:");
        System.out.println(
                "1. Regular Player - PHP 290.00"
        );
        System.out.println(
                "2. Student Player - PHP 270.00"
        );
        System.out.println(
                "3. Member Player - PHP 250.00"
        );

        int type = getIntegerInput(
                scanner,
                "Choose player type: "
        );

        Player player;

        // Polymorphism
        switch (type) {

            case 1:

                player = new RegularPlayer(
                        id,
                        name,
                        skill
                );

                break;

            case 2:

                player = new StudentPlayer(
                        id,
                        name,
                        skill
                );

                break;

            case 3:

                player = new MemberPlayer(
                        id,
                        name,
                        skill
                );

                break;

            default:

                System.out.println(
                        "Invalid player type."
                );

                return;
        }

        manager.addPlayer(player);

        System.out.println();
        System.out.println(
                "Player successfully registered!"
        );

        System.out.println(
                "Player: " + player.getName()
        );

        System.out.println(
                "Type: " + player.getPlayerType()
        );

        System.out.println(
                "Fee: PHP "
                        + String.format(
                                "%.2f",
                                player.computeFee()
                        )
        );
    }


    /* JOIN QUEUE */

    public static void joinQueue(
            Scanner scanner,
            QueueManager manager) {

        System.out.println();
        System.out.println("==================================");
        System.out.println("            JOIN QUEUE");
        System.out.println("==================================");

        int id = getIntegerInput(
                scanner,
                "Enter Player ID: "
        );

        Player player = manager.findPlayer(id);

        if (player == null) {

            System.out.println();
            System.out.println(
                    "Player not found."
            );

            System.out.println(
                    "Please register the player first."
            );

            return;
        }

        manager.joinQueue(player);
    }


    /*  START GAME */

    public static void startGame(
            Scanner scanner,
            QueueManager manager) {

        System.out.println();
        System.out.println("==================================");
        System.out.println("            START GAME");
        System.out.println("==================================");

        int playerId = getIntegerInput(
                scanner,
                "Enter Player ID: "
        );

        int courtNumber = getIntegerInput(
                scanner,
                "Enter Court Number: "
        );

        manager.startGame(
                playerId,
                courtNumber
        );
    }


    /*  END GAME */

    public static void endGame(
            Scanner scanner,
            QueueManager manager) {

        System.out.println();
        System.out.println("==================================");
        System.out.println("             END GAME");
        System.out.println("==================================");

        int courtNumber = getIntegerInput(
                scanner,
                "Enter Court Number: "
        );

        manager.endGame(courtNumber);
    }
}
