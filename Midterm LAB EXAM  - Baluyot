/* INTERFACE*/

interface Billable {

    double computeFee();

    String getFeeDescription();
}


/* ABSTRACT PLAYER CLASS  */

abstract class Player implements Billable {

    // Private fields for encapsulation
    private int playerId;
    private String name;
    private String skillLevel;
    private int gamesPlayed;

    // Constructor
    public Player(int playerId, String name, String skillLevel) {

        this.playerId = playerId;
        this.name = name;
        this.skillLevel = skillLevel;
        this.gamesPlayed = 0;
    }

    // Getters

    public int getPlayerId() {
        return playerId;
    }

    public String getName() {
        return name;
    }

    public String getSkillLevel() {
        return skillLevel;
    }

    public int getGamesPlayed() {
        return gamesPlayed;
    }

    // Setters

    public void setName(String name) {
        this.name = name;
    }

    public void setSkillLevel(String skillLevel) {
        this.skillLevel = skillLevel;
    }

    public void setGamesPlayed(int gamesPlayed) {
        this.gamesPlayed = gamesPlayed;
    }

    // Method
    public void playGame() {
        gamesPlayed++;
    }

    // Abstract method
    public abstract String getPlayerType();

    // Display player information
    public void displayInfo() {

        System.out.println("----------------------------------");
        System.out.println("Player ID: " + playerId);
        System.out.println("Name: " + name);
        System.out.println("Player Type: " + getPlayerType());
        System.out.println("Skill Level: " + skillLevel);
        System.out.println("Games Played: " + gamesPlayed);
        System.out.println("Fee: PHP " + String.format("%.2f", computeFee()));
        System.out.println("Fee Description: " + getFeeDescription());
        System.out.println("----------------------------------");
    }
}


/*  REGULAR PLAYER */

